{
  "name": "@corbits/agent-token",
  "version": "0.1.0",
  "description": "Bearer tokens that let a deployed agent definition call back into its Interchange hub: a mint/revoke mount plus a verifying middleware",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "homepage": "https://github.com/corbitsdev/corbits-agent-token#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-agent-token.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-agent-token/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun test ./e2e"
  },
  "dependencies": {
    "arktype": "^2.2.0"
  },
  "peerDependencies": {
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@types/bun": "1.3.9",
    "agent-token-0.1.0": "npm:@corbits/agent-token@0.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "postgres": "3.4.9",
    "typescript": "5.9.3"
  }
}
