{
  "name": "@corbits/agent-token",
  "version": "0.2.0",
  "description": "Bearer tokens that a deployed agent presents when it calls back into its Interchange hub: mint/revoke routes and a verifying Hono middleware",
  "keywords": [
    "agent-token",
    "auth",
    "corbits",
    "hono",
    "hub",
    "interchange"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-agent-token#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-agent-token/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-agent-token.git"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "test:e2e": "bun test e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "^2.2.0"
  },
  "devDependencies": {
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@types/bun": "1.3.9",
    "agent-token-0.1.0": "npm:@corbits/agent-token@0.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postgres": "3.4.9",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "postgres": "^3.4.8"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
