{
  "name": "@corbits/agent-token",
  "version": "0.1.0",
  "description": "Bearer tokens that let a deployed agent definition call back into its Interchange hub: a mint/revoke mount plus a verifying middleware",
  "license": "LGPL-2.1-only",
  "author": "Corbits",
  "homepage": "https://github.com/corbitsdev/corbits-agent-token#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-agent-token.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-agent-token/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "intx-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "intx-src": "./src/migrations.ts",
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src"
  },
  "dependencies": {
    "arktype": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "postgres": "^3.4.8",
    "@intx/db": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "5.9.3"
  }
}
